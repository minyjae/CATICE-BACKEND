{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "."
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    }
  ],
  "regions": ["sin1"],
  "build": {
    "env": {
      "GO_BUILD_FLAGS": "-trimpath -ldflags '-s -w'"
    }
  }
}