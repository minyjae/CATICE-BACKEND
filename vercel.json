{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "go",
  "regions": ["sin1"],
  "build": {
    "env": {
      "GO_BUILD_FLAGS": "-trimpath -ldflags '-s -w'"
    }
  },
  "env": {
    "DATABASE_URL": "@database-url",
    "JWT_SECRET": "@jwt-secret",
    "REDIS_ADDR": "@redis-addr",
    "REDIS_PASSWORD": "@redis-password"
  }
}
